<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orbit.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- ToggleSwitch reserves a 154 px minimum width for its On/Off label even when empty, which pushed every
             switch away from the right edge. ToggleSwitchThemeMinWidth is an x:Double in WinUI's generic.xaml. -->
        <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

        <!-- Windows 11 Settings-style row: icon | title + description | control -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="RowIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="24" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,16,0,4" />
        </Style>
        <Style x:Key="RowToggle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="920">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" Margin="0,0,0,8" />

            <!-- General -->
            <TextBlock Style="{StaticResource GroupHeader}" Text="General" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7B5;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Starts quietly in the system tray. Your account only, no admin rights needed." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="StartupToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE8EF;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Estimate battery between 10% steps" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="No Mac or iPhone for an exact-battery key? Orbit estimates the level within each 10% step from when the step last changed and how fast it changes. Shown as ≈66%; may be a few percent off. An exact-battery key always wins." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="EstimateToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xEBA7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Show battery in the tray icon" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="The tray icon shows the battery percentage instead of the Orbit logo." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="TrayBatteryToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE9F5;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Show unverified readings" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Also show values backed by a single community source, marked (unverified)." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="UnverifiedToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE701;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Signal threshold" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Ignore headphones weaker than this. Next to you: -35 to -60 dBm. Across a room: -75 or weaker." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider x:Name="RssiSlider" Minimum="-95" Maximum="-40" StepFrequency="1" Width="200" ValueChanged="OnChanged" />
                    <TextBlock x:Name="RssiValue" Width="60" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Auto-pause -->
            <TextBlock Style="{StaticResource GroupHeader}" Text="Auto-pause" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE769;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Pause when I take the headphones off" />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="AutoPauseToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE768;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Resume when I put them back on" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Only playback that Orbit paused." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="AutoResumeToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7F5;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Play on this PC's speakers when I take them off" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Switches back to the headphones when you put them on. Only if they were the sound output." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="AutoOutputToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE916;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Response" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Fast reacts in about 1-2 seconds. Steady waits for a confirming reading." />
                </StackPanel>
                <ComboBox x:Name="ResponseBox" Grid.Column="2" Width="200" VerticalAlignment="Center" SelectionChanged="OnChanged">
                    <ComboBoxItem Tag="fast" Content="Fast (recommended)" />
                    <ComboBoxItem Tag="steady" Content="Steady" />
                </ComboBox>
            </Grid>

            <!-- Switching -->
            <TextBlock Style="{StaticResource GroupHeader}" Text="Switching between devices" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE765;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Switch-to-this-PC hotkey" />
                    <TextBlock x:Name="HotkeyError" Style="{StaticResource RowDescription}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                </StackPanel>
                <TextBox x:Name="HotkeyBox" Grid.Column="2" Width="200" VerticalAlignment="Center" PlaceholderText="e.g. Ctrl+Alt+O" LostFocus="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE8AB;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Connect automatically" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="When Windows starts playing and the headphones are nearby but not connected." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="AutoConnectToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE702;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Connection method" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Hybrid connects fast and releases fully so your Mac can take over." />
                </StackPanel>
                <ComboBox x:Name="MethodBox" Grid.Column="2" Width="200" VerticalAlignment="Center" SelectionChanged="OnChanged">
                    <ComboBoxItem Tag="hybrid" Content="Hybrid (recommended)" />
                    <ComboBoxItem Tag="ks" Content="Audio driver only" />
                    <ComboBoxItem Tag="service" Content="Bluetooth services only" />
                </ComboBox>
            </Grid>

            <!-- Sound and notifications -->
            <TextBlock Style="{StaticResource GroupHeader}" Text="Chime and notifications" />
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xEA8F;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Chime when Orbit connects the headphones" />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="ChimeConnectToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7F6;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Chime when I put the headphones on" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="While connected to this PC. Orbit's own sound; the built-in chime can't be triggered from Windows." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="ChimePutOnToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE768;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Test chime" />
                    <TextBlock x:Name="ChimeStatus" Style="{StaticResource RowDescription}" Visibility="Collapsed" />
                </StackPanel>
                <Button Grid.Column="2" Content="Play" Width="100" VerticalAlignment="Center" Click="OnTestChime" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7E7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Connection notifications" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Notify when the headphones connect to this PC by USB-C cable or Bluetooth." />
                </StackPanel>
                <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="ConnectToastToggle" Grid.Column="2" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
            </Grid>
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xEBA7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Low-battery notification" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Notify once when the battery drops to the level on the right." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <NumberBox x:Name="LowBatteryBox" Minimum="10" Maximum="50" SmallChange="10" SpinButtonPlacementMode="Compact" Width="90" ValueChanged="OnNumberChanged" />
                    <TextBlock Text="%" VerticalAlignment="Center" />
                    <ToggleSwitch Width="52" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" x:Name="LowBatteryToggle" Style="{StaticResource RowToggle}" Toggled="OnChanged" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="SavedText" Margin="2,12,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
