<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Orbit.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Orbit menu">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
            <!-- Disabled items render as dimmed text, like a menu, not as a grey button. -->
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <StackPanel Padding="4" Spacing="1">
            <!-- Status header -->
            <Grid Padding="11,8,11,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Orbit.png" Width="24" Height="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <MenuFlyoutSeparator />

            <Button x:Name="SwitchButton" Style="{StaticResource MenuButton}" Click="OnSwitch">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                    <TextBlock x:Name="SwitchText" Text="Switch to this PC" />
                </StackPanel>
            </Button>
            <Button x:Name="ReleaseButton" Style="{StaticResource MenuButton}" Click="OnRelease">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8F0;" FontSize="16" />
                    <TextBlock Text="Release to other device" />
                </StackPanel>
            </Button>

            <MenuFlyoutSeparator />

            <Grid Padding="11,0" MinHeight="34" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE769;" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Auto-pause" VerticalAlignment="Center" />
                <ToggleSwitch Width="40" MinWidth="0" HorizontalAlignment="Right" x:Name="AutoPauseSwitch" Grid.Column="2" OnContent="" OffContent="" Toggled="OnAutoPauseToggled" />
            </Grid>
            <Grid Padding="11,0" MinHeight="34" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7B5;" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Start with Windows" VerticalAlignment="Center" />
                <ToggleSwitch Width="40" MinWidth="0" HorizontalAlignment="Right" x:Name="StartupSwitch" Grid.Column="2" OnContent="" OffContent="" Toggled="OnStartupToggled" />
            </Grid>

            <MenuFlyoutSeparator />

            <Button Style="{StaticResource MenuButton}" Click="OnOpen">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7F6;" FontSize="16" />
                    <TextBlock Text="Open Orbit" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuButton}" Click="OnSettings">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuButton}" Click="OnExit">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock Text="Quit Orbit" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
