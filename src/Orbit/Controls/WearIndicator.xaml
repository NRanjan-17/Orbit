<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Orbit.Controls.WearIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="120" Height="120">

    <!-- 120x120 canvas: a head and shoulders, with a headphones layer that slides on/off. -->
    <Viewbox>
        <Canvas Width="120" Height="120">
            <!-- Shoulders -->
            <Path Data="M 28,104 C 30,86 44,80 60,80 C 76,80 90,86 92,104"
                  Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <!-- Head -->
            <Ellipse Canvas.Left="44" Canvas.Top="38" Width="32" Height="38"
                     Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="3" />

            <!-- Headphones layer (moved by TranslateY / Rotation) -->
            <Canvas x:Name="Headphones" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <CompositeTransform x:Name="PhonesTransform" TranslateY="-26" Rotation="-8" />
                </Canvas.RenderTransform>
                <!-- Headband over the top of the head -->
                <Path Data="M 38,58 C 38,30 82,30 82,58"
                      Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <!-- Ear cups at ear height -->
                <Rectangle Canvas.Left="32" Canvas.Top="52" Width="11" Height="20" RadiusX="4" RadiusY="4" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <Rectangle Canvas.Left="77" Canvas.Top="52" Width="11" Height="20" RadiusX="4" RadiusY="4" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
