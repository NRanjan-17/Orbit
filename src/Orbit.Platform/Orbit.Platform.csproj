<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-specific implementations: BLE scanning (WinRT), media sessions (WinRT),
       Bluetooth connect/disconnect (Win32), startup registration. No UI. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Orbit.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
  </ItemGroup>

</Project>
